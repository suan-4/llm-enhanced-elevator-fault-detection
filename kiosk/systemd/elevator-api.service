[Unit]
Description=Elevator Report API
After=network.target neo4j.service elevator-rkllm.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/elevator/backend
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8081
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
