# ── 业务数据库（用户账号 / 报告历史 / 填写记录）──
# 相对路径按 backend/ 目录解析；使用 Python 标准库 sqlite3，无需额外依赖
SQLITE_PATH=data/elevator.db
SESSION_TTL_HOURS=168
HISTORY_LIMIT=50

